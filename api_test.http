    "id_usuario": "2",
    "nombre_comercial": "Nonna Enterprise",
    "descripcion": "adsfgwgrt",
    "logo": "",
    "portada": "",
    "telefono": "123456",
    "correo": "juan.perez.test@nonnatest.com",
    "sitio_web": "",
    "redes_sociales": ""
}


### Nueva Sucursal

POST https://proyecto-anual-nonna-production.up.railway.app/nueva_sucursal
Content-Type: application/json

{
    "id_negocio": "4",
    "nombre": "Nonna Enterprise Moreno",
    "direccion": "Osorio y Moreno 123",
    "horarios": "10:00 - 20:00",
    "casa_central": "0"
}

































